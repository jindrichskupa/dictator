# dict cd — move the calling shell into a session's directory.
# This is why dict is a shell function and not a script on $PATH.
emulate -L zsh
_dict_require jq || return 1

local id=${1:-}
[[ -n $id ]] || { id=$(_dict_pick) || return 1 }

local entry target
entry=$(_dict_get $id) || { print -ru2 -- "dict: unknown session: $id"; return 1 }
target=$(print -r -- $entry | jq -r '.dir')
[[ -d $target ]] || { print -ru2 -- "dict: directory is gone: $target"; return 1 }
cd $target
