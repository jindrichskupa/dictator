# dict help — everything you can press or type, on one screen.
# Autoloaded, so editing it takes effect without reloading the library.
emulate -L zsh

local b='' d='' c='' r=''
if [[ -t 1 ]]; then
  b=$'\e[1m'; d=$'\e[2m'; c=$'\e[36m'; r=$'\e[0m'
fi

print -r -- ""
print -r -- "  ${b}dictator${r}${d}  —  one registry of Claude Code sessions across every repository${r}"
print -r -- ""
print -r -- "  ${b}COMMANDS${r}"
print -r -- "    ${c}dict new${r} [--refresh]     pick a repository, name the work, start a session"
print -r -- "    ${c}dict ls${r}                  list every session and its state"
print -r -- "    ${c}dict sw${r} [query]          switch; a query matching one session goes straight there"
print -r -- "    ${c}dict up${r} [id...]          revive sessions a reboot killed, conversation intact"
print -r -- "    ${c}dict cd${r} [id]             move this shell into a session's directory"
print -r -- "    ${c}dict note${r} <id> <text>    annotate a session"
print -r -- "    ${c}dict rename${r} [id] [title] retitle a session          ${d}the id never changes${r}"
print -r -- "    ${c}dict kill${r} [id...]        stop any live session, keep it listed  ${d}dict up brings it back${r}"
print -r -- "    ${c}dict rm${r} [id...]          end sessions for good      ${d}(no args: multi-select)${r}"
print -r -- "    ${c}dict prune${r} [days]        forget everything stale    ${d}(default: 7 days)${r}"
print -r -- "    ${c}dict where${r} [id]          which session is this shell in ${d}title, repo, state${r}"
print -r -- "    ${c}dict reload${r}              re-source the library after editing it"
print -r -- ""
print -r -- "  ${b}KEYS${r}${d}   prefix is C-a${r}"
print -r -- "    ${c}prefix N${r}                 new session"
print -r -- "    ${c}prefix S${r}                 switch session          ${d}fzf, with a live preview${r}"
print -r -- "    ${c}prefix R${r}                 rename a session        ${d}title only${r}"
print -r -- "    ${c}prefix K${r}                 stop a session   ${d}reversible${r}"
print -r -- "    ${c}prefix X${r}                 forget a session ${d}permanent${r}"
print -r -- "    ${c}prefix enter${r}             shell in this session's directory ${d}popup${r}"
print -r -- "    ${c}prefix c${r}                 same, as a window"
print -r -- "    ${c}prefix | -${r}               same, as a split"
print -r -- "    ${c}prefix i${r}                 which session is this  ${d}one line, fades on its own${r}"
print -r -- "    ${c}prefix ?${r}                 this help"
print -r -- "    ${c}prefix r${r}                 reload the tmux config"
print -r -- "    ${d}prefix w${r}                 session tree            ${d}native tmux${r}"
print -r -- "    ${d}prefix ( )${r}               previous / next session ${d}native tmux${r}"
print -r -- "    ${d}prefix L${r}                 last session            ${d}native tmux${r}"
print -r -- "    ${d}prefix d${r}                 detach                  ${d}native tmux${r}"
print -r -- ""
print -r -- "  ${b}IN THE PICKER${r}"
print -r -- "    ${c}type${r}                     filters on title, repository and id at once"
print -r -- "    ${c}enter${r}                    do what the dialog is labelled ${d}switch, kill, remove, revive${r}"
print -r -- "    ${c}tab${r}                      mark          ${d}where several can be picked${r}"
print -r -- "    ${c}ctrl-r${r}                   rescan for repositories ${d}new session dialog only${r}"
print -r -- "    ${c}esc${r}                      cancel"
print -r -- ""
print -r -- "  ${b}STATES${r}"
print -r -- "    ${c}● running${r}                Claude is working"
print -r -- "    ${c}◆ waiting${r}                ${b}Claude wants input or permission${r}"
print -r -- "    ${c}✓ done${r}                   Claude finished its turn"
print -r -- "    ${c}· ended${r}                  the session was closed"
print -r -- "    ${c}✗ dead${r}                   registered but not running  ${d}— dict up${r}"
print -r -- "    ${c}! orphan${r}                 its directory is gone       ${d}— dict rm${r}"
print -r -- ""
print -r -- "  ${d}sessions live on their own tmux server:  tmux -L dictator attach${r}"
print -r -- ""
