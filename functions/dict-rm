# dict rm — end sessions for good: kill tmux, drop the registry entry, and
# remove the worktree only when it holds nothing that exists solely there.
#
# Always asks. This is the irreversible one.
emulate -L zsh
_dict_require jq || return 1

local -a ids
if (( $# )); then
  ids=($@)
else
  ids=(${(f)"$(_dict_pick --multi)"})
fi
(( $#ids )) || return 1

# Refuse unknown ids before asking anything, so a typo cannot reach a dialog.
local id
for id in $ids; do
  _dict_get $id >/dev/null 2>&1 || {
    print -ru2 -- "dict: unknown session: $id"
    return 1
  }
done

local what
if (( $#ids == 1 )); then
  what="forget '${ids[1]}'? this cannot be undone"
else
  what="forget ${#ids} sessions? this cannot be undone"
fi
_dict_confirm 'remove' "$what" no || { print -r -- 'dict: nothing removed'; return 1 }

integer failures=0
for id in $ids; do
  _dict_forget $id || (( failures++ ))
done
(( failures == 0 ))
